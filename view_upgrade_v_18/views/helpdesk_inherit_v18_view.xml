<odoo>
<data>


<record id="helpdesk_form_inherit_v18" model="ir.ui.view">
<field name="name">helpdesk.form.inherit_v18</field>
<field name="model">helpdesk.ticket</field>
<field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form" />
<field name="arch" type="xml">
    <xpath expr="//field[@name='product_serie_id']" position="after">
      <field name="partner_name"/>
    </xpath>
    <xpath expr="//field[@name='is_partner_phone_update']" position="after">
      <field name="partner_email" string="Email"/>
    </xpath>
</field>
</record>
</data>
</odoo>
