<odoo>
  <data>

    <record id="stock_form_inherit" model="ir.ui.view">
      <field name="name">stock.form.inherit</field>
      <field name="model">stock.picking</field>
      <field name="inherit_id" ref="stock.view_picking_form" />
      <field name="arch" type="xml">

        <xpath expr="//button[@name='action_cancel']" position="after">
          <button string="Bon livraison" name="stock.action_report_delivery" type="action"
            class="oe_highlight"
            invisible="state == 'delivery' or picking_type_id != 2 or stock_block_yes_1 == 'Impaye' " />
        </xpath>

        <xpath expr="//button[@name='action_cancel']" position="after">
          <button string="Bon de reprise" class="oe_highlight" name="stock.return_label_report" type="action" invisible="picking_type_id not in [6]"/>
        </xpath>


        <xpath expr="//button[@name='action_cancel']" position="attributes">
          <attribute name="invisible">state not in ["assigned", "confirmed", "draft", "waiting",
            "delivery"]</attribute>
        </xpath>

        <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
          <page string="Signature" name="signture_livraison">
            <group name="groupe1">
              <group name="left">
                <field widget="signature" name="signature" />
              </group>
              <group name="right" />
            </group>
          </page>
        </xpath>
      </field>
    </record>

  </data>


</odoo>
